# Optional for local runs; Docker/systemd should point this at the persistent data volume.
DATA_DIR=./data
EVENT_SLUG=integrity-2026
EVENT_TITLE=科研诚信研讨会
EVENT_SUBTITLE=以诚立身，以实求真
EVENT_ORGANIZATION=科研诚信主题活动
# New deployments start closed. Set to live only after the event has been configured.
EVENT_STATUS=draft
ADMIN_TOKEN=replace-with-a-long-random-token
MONITOR_TOKEN=replace-with-another-long-random-token
# Optional: the address participants use, so QR codes carry the domain instead of the
# request's Host header. Leave empty to derive it from each request.
PUBLIC_BASE_URL=https://wall.example.com
